# Скопируй в .env и заполни. .env в git не попадает.

# Кто разбирает письма:
#   cli (по умолчанию) — локальный claude, работает на твоей подписке Claude Code, ключ не нужен.
#   api                — HTTP-API Anthropic, требует ANTHROPIC_API_KEY ниже.
LLM_PROVIDER=cli

# Только для LLM_PROVIDER=api.
ANTHROPIC_API_KEY=

# Модель. Для cli — алиас (sonnet/opus/haiku), для api — полный id (claude-sonnet-5).
# Пусто = sonnet.
CLAUDE_MODEL=

# Путь к бинарю claude, если он не в PATH.
CLAUDE_BIN=

# Токен телеграм-бота от @BotFather. Пусто — бот не запускается, работает только сайт.
TELEGRAM_TOKEN=

# Твой chat_id. Если задан — сообщения из других чатов игнорируются.
# Узнать: напиши боту и открой https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Имя бота (@ можно не писать). Нужно только для кнопки «Написать письмо» на дашборде.
BOT_USERNAME=

# Порт HTTP-сервера.
PORT=8777

# Базовый адрес сайта, который бот шлёт в ссылках.
SITE_URL=http://localhost:8777

# Пути. Обычно менять не надо.
DB_PATH=data/english.db
TOPICS_PATH=content/topics.json
LESSONS_DIR=content/lessons
WEB_DIR=web
